# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# LINE Messaging API
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-nano
DAILY_AI_TOKEN_BUDGET=100000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mallnew_friends_bot

# Authorization
ADMIN_LINE_USER_IDS=

# Retention (days)
RAW_MESSAGE_RETENTION_DAYS=30
CONTENT_LOG_RETENTION_DAYS=7
PERSONA_DECAY_DAYS=180

# Selective response tuning
AMBIENT_DELAY_MIN_SECONDS=15
AMBIENT_DELAY_MAX_SECONDS=30
COOLDOWN_MIN_SECONDS=180
COOLDOWN_MAX_SECONDS=300
REPLY_TOKEN_SAFETY_MARGIN_SECONDS=45
CONTEXT_MESSAGE_LIMIT=30
CONTEXT_WINDOW_MINUTES=10
